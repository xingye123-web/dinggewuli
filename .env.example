# 复制成 .env 再填写，.env 不要提交到仓库。密钥只放在环境变量里，代码里没有任何密钥。

# ---------- 服务器（接口 service.api + 网页 web） ----------
# 网页调用接口用的令牌，换成一串足够长的随机字符；网页的 web/.env.local 里也要填同一个值
RENDER_API_TOKEN=
# 网页所在的地址，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000
# 邀请码，多个用逗号分隔；留空表示不需要邀请码
INVITE_CODES=
# 每个邀请码每天最多提交几道题
MAX_JOBS_PER_DAY=30
# 笔记本 worker 领任务用的令牌，服务器和笔记本要一致
WORKER_TOKEN=
# 任务和视频存放的目录
ARTIFACTS_DIR=/var/lib/dingge/artifacts

# ---------- 笔记本 worker（service.laptop_worker） ----------
# 服务器的 worker 接口地址
HUB_URL=https://你的域名/worker-api
# DeepSeek：读题、解题和写场景代码
CHUANZHI_DEEPSEEK_API_KEY=
# Breeze Blue：讲解配音
CHUANZHI_BREEZE_API_KEY=
# 渲染在 Docker 隔离容器里进行，镜像由 render/Dockerfile 构建
RENDER_RUNNER=docker
RENDERER_IMAGE=physics-renderer:0.1

# ---------- 可选：模型和参数（不填用默认值） ----------
# DEEPSEEK_VISION_MODEL=deepseek-flash
# DEEPSEEK_SOLVE_MODEL=deepseek-flash
# DEEPSEEK_SOLVE_EFFORT=high
# DEEPSEEK_AUTHOR_MODEL=deepseek-flash
# DEEPSEEK_AUTHOR_EFFORT=low
# MAX_AUTHOR_ATTEMPTS=4
# BREEZE_VOICE=voc_xb3zjqcmwp44
# BREEZE_SPEED=0.95
# DEEPSEEK_URL=https://api.deepseek.com
# BREEZE_URL=https://api.breeze.blue

# ---------- 可选：渲染容器的资源限制和时限 ----------
# 每道题分几段并行渲染；每段容器的 CPU、内存、临时盘、进程数上限
# RENDER_CLIPS=4
# RENDER_CPUS=4
# RENDER_MEMORY=4g
# RENDER_TMPFS=4g
# RENDER_PIDS=256
# 预演（检查布局）和渲染的时限，单位秒；容器视频输出的大小上限，单位字节
# PREPARE_TIMEOUT=150
# RENDER_TIMEOUT=900
# MAX_OUTPUT_BYTES=314572800

# ---------- 可选：服务器调度 ----------
# worker 多久没报平安，任务退回队列（秒）；多久没来领任务，网页显示“生成服务离线”（秒）
# LEASE_SECONDS=120
# WORKER_ONLINE_SECONDS=45
# worker 上传结果的大小上限（字节）
# MAX_UPLOAD_BYTES=209715200
# 零件需求记录放在哪个目录（默认 .dev/requests）
# PART_REQUESTS_DIR=
